{
	"name": "smrt-framework-docs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.11.0",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run check:templates && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:copy": "node scripts/check-copy.mjs",
		"check:ui-reference": "node scripts/generate-ui-component-reference.mjs --check",
		"check:templates": "node scripts/check-svelte-templates.js",
		"check:links": "node scripts/check-links.mjs",
		"audit:data": "node scripts/check-data-freshness.mjs",
		"generate:ui-reference": "node scripts/generate-ui-component-reference.mjs",
		"check:smrt": "node scripts/update-smrt.mjs --check",
		"update:smrt": "node scripts/update-smrt.mjs",
		"lint": "prettier --check . && eslint . && pnpm run check:templates",
		"format": "prettier --write .",
		"test": "pnpm run check:smrt && pnpm run check:copy && pnpm run check:ui-reference && vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@happyvertical/smrt-cli": "0.57.3",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "2.69.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/svelte": "^5.4.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"glob": "^13.0.6",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.71.2",
		"vite": "8.1.4",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@happyvertical/smrt-agents": "0.57.3",
		"@happyvertical/smrt-analytics": "0.57.3",
		"@happyvertical/smrt-assets": "0.57.3",
		"@happyvertical/smrt-chat": "0.57.3",
		"@happyvertical/smrt-commerce": "0.57.3",
		"@happyvertical/smrt-content": "0.57.3",
		"@happyvertical/smrt-events": "0.57.3",
		"@happyvertical/smrt-fields": "0.57.3",
		"@happyvertical/smrt-images": "0.57.3",
		"@happyvertical/smrt-jobs": "0.57.3",
		"@happyvertical/smrt-ledgers": "0.57.3",
		"@happyvertical/smrt-messages": "0.57.3",
		"@happyvertical/smrt-personas": "0.57.3",
		"@happyvertical/smrt-planner": "0.57.3",
		"@happyvertical/smrt-playground": "0.57.3",
		"@happyvertical/smrt-profiles": "0.57.3",
		"@happyvertical/smrt-projects": "0.57.3",
		"@happyvertical/smrt-reports": "0.57.3",
		"@happyvertical/smrt-svelte": "0.57.3",
		"@happyvertical/smrt-tenancy": "0.57.3",
		"@happyvertical/smrt-ui": "0.57.3",
		"@happyvertical/smrt-users": "0.57.3",
		"@happyvertical/smrt-web": "0.57.3"
	}
}
