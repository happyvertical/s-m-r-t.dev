{
	"name": "smrt-framework-docs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.34.4",
	"engines": {
		"node": ">=24.18.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run check:templates && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:templates": "node scripts/check-svelte-templates.js",
		"update:smrt": "node scripts/update-smrt.mjs",
		"lint": "prettier --check . && eslint . && pnpm run check:templates",
		"format": "prettier --write .",
		"test": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/svelte": "^5.3.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"glob": "^11.0.0",
		"globals": "^17.0.0",
		"jsdom": "^27.4.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.52.0",
		"vite": "^7.2.6",
		"vitest": "^4.0.16"
	},
	"dependencies": {
		"@happyvertical/smrt-agents": "0.40.61",
		"@happyvertical/smrt-analytics": "0.40.61",
		"@happyvertical/smrt-assets": "0.40.61",
		"@happyvertical/smrt-chat": "0.40.61",
		"@happyvertical/smrt-commerce": "0.40.61",
		"@happyvertical/smrt-content": "0.40.61",
		"@happyvertical/smrt-events": "0.40.61",
		"@happyvertical/smrt-images": "0.40.61",
		"@happyvertical/smrt-jobs": "0.40.61",
		"@happyvertical/smrt-ledgers": "0.40.61",
		"@happyvertical/smrt-messages": "0.40.61",
		"@happyvertical/smrt-personas": "0.40.61",
		"@happyvertical/smrt-playground": "0.40.61",
		"@happyvertical/smrt-profiles": "0.40.61",
		"@happyvertical/smrt-projects": "0.40.61",
		"@happyvertical/smrt-reports": "0.40.61",
		"@happyvertical/smrt-svelte": "0.40.61",
		"@happyvertical/smrt-tenancy": "0.40.61",
		"@happyvertical/smrt-ui": "0.40.61",
		"@happyvertical/smrt-users": "0.40.61",
		"@happyvertical/smrt-web": "0.40.61"
	}
}
