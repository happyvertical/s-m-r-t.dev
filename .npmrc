# Authentication is provided by CI (actions/setup-node writes user-level .npmrc)
# or local dev environment (~/.npmrc). Do NOT add a `_authToken=${VAR}` line
# here — Renovate's sandbox cannot resolve the substitution, which causes
# `pnpm install --lockfile-only` to fail silently and leaves renovate PRs
# with an out-of-sync pnpm-lock.yaml.
engine-strict=true
@happyvertical:registry=https://npm.pkg.github.com
