# The primary HappyVertical registry publishes the released lockstep SMRT line.
# Keep this project-local override so a parent or user-level registry setting
# cannot select a stale mirror.
@happyvertical:registry=https://npm.happyvertical.com/
engine-strict=true
# QA SESSION ONLY (2026-10 site refresh; see `//qa` in package.json): the
# linked smrt-planner worktree imports smrt-core directly, and the site only
# has it transitively. Hoist the site's single copy to the root so Vite's
# `resolve.dedupe` can pick it. Remove with the override.
public-hoist-pattern[]=@happyvertical/smrt-core
